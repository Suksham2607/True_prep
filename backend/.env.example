DATABASE_URL=your_database_url_here
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Required for the Mock Interview feature (Milestone 8+) - get a free key
# at console.groq.com. Without this, everything else in the app works
# fine, but starting/continuing/ending a mock interview will fail with a
# clear "isn't available right now" error instead of a raw crash.
GROQ_API_KEY=your_groq_api_key_here
